{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shop-kosomba.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://shop-kosomba.onrender.com/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
